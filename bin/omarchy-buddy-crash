#!/usr/bin/env python3
# A click on a crash item in the island (omarchy-buddy-feed): Omarchy's own
# diagnosis, the default agent with its diagnose-crash skill in a terminal
# (omarchy-agent-crash, Omarchy 4.0.6+); without it or without a default
# agent `coredumpctl info` in a terminal.
#
#   omarchy-buddy-crash PID

import json
import os
import re
import shutil
import signal
import subprocess
import sys


def main():
    pid = sys.argv[1] if len(sys.argv) == 2 and re.fullmatch(r"[0-9]+", sys.argv[1]) else None
    if not pid:
        sys.exit("usage: omarchy-buddy-crash PID")
    if shutil.which("omarchy-agent-crash") and shutil.which("omarchy-default-agent") \
            and subprocess.run(["omarchy-default-agent"], capture_output=True, text=True).stdout.strip():
        out = subprocess.run(["coredumpctl", "--json=short", "--no-pager", pid], capture_output=True, text=True).stdout
        try:
            # Only the user's own: a PID comes back, and another account's
            # crash would put its program's path into the agent's prompt (#227).
            dump = [d for d in json.loads(out) if isinstance(d, dict) and d.get("uid") == os.getuid()][-1]
        except (ValueError, IndexError, TypeError):
            dump = {}  # rotated away: the agent still gets the pid
        exe = str(dump.get("exe") or "unknown")
        try:
            sig = signal.Signals(dump.get("sig")).name
        except (ValueError, TypeError):
            sig = "unknown"
        os.execvp("omarchy-agent-crash", ["omarchy-agent-crash", pid, os.path.basename(exe), exe, sig])
    info = ["coredumpctl", "info", pid]
    if shutil.which("omarchy-launch-tui"):
        cmd = ["omarchy-launch-tui", *info]
    elif shutil.which("xdg-terminal-exec"):
        cmd = ["xdg-terminal-exec", *info]
    elif os.environ.get("TERMINAL"):
        cmd = [os.environ["TERMINAL"], "-e", *info]
    else:
        sys.exit("omarchy-buddy-crash: no terminal found")
    subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
