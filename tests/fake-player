#!/usr/bin/env python3
# A music player for tests/live and tests/gallery: an MPRIS player named
# "Buddy-Test" on the session bus (org.mpris.MediaPlayer2.buddytest) that
# plays nothing, but answers like one. The island's test IPC only ever
# clicks the player window's buttons while this one is shown.
#
#   tests/fake-player [--title T] [--artist A] [--cover] [--length S]
#                     [--paused] [--no-seek] [--no-prev] [--no-next] [--spotify]
#                     [--spotify-app]
#
# Runs until killed. Every method call is printed on stdout ("PlayPause",
# "SetPosition 42.0", ...), so a test can see what the island asked for.

import argparse
import os
import signal
import sys
import time

from gi.repository import Gio, GLib

XML = """
<node>
  <interface name="org.mpris.MediaPlayer2">
    <method name="Raise"/><method name="Quit"/>
    <property name="Identity" type="s" access="read"/>
    <property name="DesktopEntry" type="s" access="read"/>
    <property name="CanQuit" type="b" access="read"/>
    <property name="CanRaise" type="b" access="read"/>
    <property name="HasTrackList" type="b" access="read"/>
    <property name="SupportedUriSchemes" type="as" access="read"/>
    <property name="SupportedMimeTypes" type="as" access="read"/>
  </interface>
  <interface name="org.mpris.MediaPlayer2.Player">
    <method name="Next"/><method name="Previous"/><method name="Pause"/>
    <method name="PlayPause"/><method name="Stop"/><method name="Play"/>
    <method name="Seek"><arg direction="in" name="Offset" type="x"/></method>
    <method name="SetPosition"><arg direction="in" name="TrackId" type="o"/><arg direction="in" name="Position" type="x"/></method>
    <signal name="Seeked"><arg name="Position" type="x"/></signal>
    <property name="PlaybackStatus" type="s" access="read"/>
    <property name="Rate" type="d" access="readwrite"/>
    <property name="Metadata" type="a{sv}" access="read"/>
    <property name="Volume" type="d" access="readwrite"/>
    <property name="Position" type="x" access="read"/>
    <property name="MinimumRate" type="d" access="read"/>
    <property name="MaximumRate" type="d" access="read"/>
    <property name="CanGoNext" type="b" access="read"/>
    <property name="CanGoPrevious" type="b" access="read"/>
    <property name="CanPlay" type="b" access="read"/>
    <property name="CanPause" type="b" access="read"/>
    <property name="CanSeek" type="b" access="read"/>
    <property name="CanControl" type="b" access="read"/>
  </interface>
</node>
"""
PATH = "/org/mpris/MediaPlayer2"
TRACK = "/org/buddytest/track/1"

ap = argparse.ArgumentParser()
ap.add_argument("--title", default="Ein Lied zum Testen")
ap.add_argument("--artist", default="Buddy-Test")
ap.add_argument("--cover", action="store_true", help="a generated cover (a gradient)")
ap.add_argument("--length", type=float, default=215)
ap.add_argument("--paused", action="store_true")
ap.add_argument("--no-seek", action="store_true")
ap.add_argument("--no-prev", action="store_true")
ap.add_argument("--no-next", action="store_true")
ap.add_argument("--spotify", action="store_true", help="a Spotify track id, for Spotify's + (#121)")
ap.add_argument("--spotify-app", action="store_true",
                help="also named like Spotify's desktop app (org.mpris.MediaPlayer2.spotify.instancePID), for #162")
args = ap.parse_args()
if args.spotify or args.spotify_app:
    TRACK = "/com/spotify/track/4uLU6hMCjMI75M1A2tKUQC"

art = ""
if args.cover:
    import tempfile
    fd, art = tempfile.mkstemp(prefix="buddy-test-cover-", suffix=".ppm")
    with os.fdopen(fd, "wb") as f:
        f.write(b"P6 256 256 255\n" + bytes(v for y in range(256) for x in range(256) for v in (x, 90, 255 - y)))

status = "Paused" if args.paused else "Playing"
pos_us = 63_000_000  # where the track stands at `since`
since = time.monotonic()
conn = None


def position():
    run = (time.monotonic() - since) * 1e6 if status == "Playing" else 0
    return int(min(pos_us + run, args.length * 1e6))


def metadata():
    m = {"mpris:trackid": GLib.Variant("o", TRACK), "mpris:length": GLib.Variant("x", int(args.length * 1e6)),
         "xesam:title": GLib.Variant("s", args.title), "xesam:artist": GLib.Variant("as", [args.artist])}
    if art:
        m["mpris:artUrl"] = GLib.Variant("s", "file://" + art)
    return m


def props():
    return {
        "org.mpris.MediaPlayer2": {
            "Identity": GLib.Variant("s", "Buddy-Test"), "DesktopEntry": GLib.Variant("s", "buddy-test"),
            "CanQuit": GLib.Variant("b", False), "CanRaise": GLib.Variant("b", False),
            "HasTrackList": GLib.Variant("b", False), "SupportedUriSchemes": GLib.Variant("as", []),
            "SupportedMimeTypes": GLib.Variant("as", []),
        },
        "org.mpris.MediaPlayer2.Player": {
            "PlaybackStatus": GLib.Variant("s", status), "Rate": GLib.Variant("d", 1.0),
            "Metadata": GLib.Variant("a{sv}", metadata()), "Volume": GLib.Variant("d", 1.0),
            "Position": GLib.Variant("x", position()), "MinimumRate": GLib.Variant("d", 1.0),
            "MaximumRate": GLib.Variant("d", 1.0), "CanGoNext": GLib.Variant("b", not args.no_next),
            "CanGoPrevious": GLib.Variant("b", not args.no_prev), "CanPlay": GLib.Variant("b", True),
            "CanPause": GLib.Variant("b", True), "CanSeek": GLib.Variant("b", not args.no_seek),
            "CanControl": GLib.Variant("b", True),
        },
    }


def changed(names):
    iface = "org.mpris.MediaPlayer2.Player"
    p = props()[iface]
    conn.emit_signal(None, PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                     GLib.Variant("(sa{sv}as)", (iface, {n: p[n] for n in names}, [])))


def set_status(new):
    global status, pos_us, since
    pos_us, since, status = position(), time.monotonic(), new
    changed(["PlaybackStatus"])


def seek_to(us):
    global pos_us, since
    pos_us, since = max(0, min(int(us), int(args.length * 1e6))), time.monotonic()
    conn.emit_signal(None, PATH, "org.mpris.MediaPlayer2.Player", "Seeked", GLib.Variant("(x)", (pos_us,)))


def on_call(_conn, _sender, _path, _iface, method, params, invocation):
    print(method, *[p / 1e6 for p in params.unpack() if isinstance(p, int)], flush=True)
    if method == "PlayPause":
        set_status("Paused" if status == "Playing" else "Playing")
    elif method == "Play":
        set_status("Playing")
    elif method in ("Pause", "Stop"):
        set_status("Paused")
    elif method == "Seek" and not args.no_seek:
        seek_to(position() + params.unpack()[0])
    elif method == "SetPosition" and not args.no_seek:
        seek_to(params.unpack()[1])
    invocation.return_value(None)


def on_get(_conn, _sender, _path, iface, name):
    return props()[iface][name]


def on_bus(c, _name):
    global conn
    conn = c
    for info in Gio.DBusNodeInfo.new_for_xml(XML).interfaces:
        c.register_object(PATH, info, on_call, on_get, None)


NAME = f"org.mpris.MediaPlayer2.spotify.instance{os.getpid()}" if args.spotify_app else "org.mpris.MediaPlayer2.buddytest"
Gio.bus_own_name(Gio.BusType.SESSION, NAME, Gio.BusNameOwnerFlags.NONE,
                 on_bus, None, lambda *_: sys.exit("Der Busname ist schon belegt."))
loop = GLib.MainLoop()
try:
    from gi.repository import GLibUnix
    signal_add = GLibUnix.signal_add
except ImportError:
    signal_add = GLib.unix_signal_add
for sig in (signal.SIGTERM, signal.SIGINT):
    signal_add(GLib.PRIORITY_DEFAULT, sig, loop.quit)
try:
    loop.run()
finally:
    if art:
        os.unlink(art)
