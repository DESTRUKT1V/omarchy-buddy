# File changes as a diff: a short edit, a long one (unfolded, scrolls) and a
# new file, in the theme and in a light one (rose-pine, only the island).
light='{"foreground": "#575279", "background": "#faf4ed", "accent": "#56949f", "urgent": "#b4637a"}'
diff_short='{"file_path": "/tmp/projekt/shell/Theme.qml", "old_string": "  readonly property int fCaption: s(11)\n  readonly property int fBody: s(13)\n  readonly property int fTitle: s(15)", "new_string": "  readonly property int fCaption: s(11)\n  readonly property int fBody: s(14)\n  readonly property int fTitle: s(15)"}'
diff_long=$(jq -nc --arg l "$long" '[range(1; 61) | "zeile_\(.) = \"Text \(.)\""] as $a |
  {file_path: "/tmp/projekt/lib/sehr/tief/verschachtelter/ordner/mit/langem/namen/einstellungen.py",
   old_string: ($a | join("\n")),
   new_string: ($a | .[4] = "zeile_5 = \"Geändert \($l)\"" | .[20:22] = [] | .[40] = "neu_41 = True\nneu_42 = False" | join("\n"))}')
diff_new=$(jq -nc --arg f "/tmp/buddy-test-neu-$run.md" --arg l "$long" '{file_path: $f,
  content: ("# Neue Datei\n\nDie Insel \($l).\n\n" + ([range(1; 26) | "- Punkt \(.)"] | join("\n")) + "\n")}')
for theme in dark light; do
  [[ $theme == light ]] && probe testColors "$light" >/dev/null
  label=$([[ $theme == light ]] && echo " (hell)" || echo "")
  ask_tool "${run}d" Edit "$diff_short"
  show "Diff: kurze Änderung$label" "$tall"
  end_ask "${run}d"; sleep 0.5
  ask_tool "${run}e" Edit "$diff_long"
  show "Diff: lange Änderung$label" "$tall"
  click "ganze Änderung"
  show "Diff: lange Änderung aufgeklappt$label" "$tall"
  end_ask "${run}e"; sleep 0.5
  ask_tool "${run}w" Write "$diff_new"
  show "Diff: neue Datei$label" "$tall"
  end_ask "${run}w"; sleep 0.5
done
