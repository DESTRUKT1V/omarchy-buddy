results = []  # (name, "ok" | "fehler" | "übersprungen", detail)


def report(name, status, detail=""):
    results.append((name, status, detail))
    mark = {"ok": "✓", "fehler": "✗", "übersprungen": "–"}[status]
    print(f"{mark} {name}" + (f": {detail}" if detail else ""), flush=True)


def check(name, ok, detail=""):
    report(name, "ok" if ok else "fehler", "" if ok else detail + disturbed())
    return ok


def disturbed():
    """What real, not the test's, is on the island right now: a failure then
    may come from outside (another agent's request, a real pop-up)."""
    s = state() or {}
    ask, toast = s.get("ask") or {}, s.get("toast") or {}
    parts = (["eine echte Rückfrage ist offen"] if ask and not str(ask.get("session", "")).startswith("buddy-test-") else []) \
        + (["ein echtes Pop-up"] if toast and toast.get("app") != TEST_APP and not str(toast.get("key", "")).startswith("buddy-test-") else []) \
        + (["du warst weg oder Vollbild"] if s.get("paused") else [])
    return f" (dabei: {', '.join(parts)})" if parts else ""


# ---------------------------------------------------------------- shell IPC

def ipc(target, method, *args):
    env = dict(os.environ, OMARCHY_PATH=OMARCHY, OMARCHY_SHELL_IPC_TIMEOUT="3s")
    try:
        out = subprocess.run(["omarchy-shell", target, method, *map(str, args)], env=env,
                             capture_output=True, text=True, timeout=8)
        return out.stdout.strip() if out.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def state():
    raw = ipc("omarchy-buddy.test", "state")
    try:
        return json.loads(raw)
    except (TypeError, ValueError):
        return None


# ---------------------------------------------------------------- D-Bus

bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
signals = []  # (name, args) of ActionInvoked, NotificationReplied, NotificationClosed


def on_signal(_conn, _sender, _path, _iface, name, params):
    signals.append((name, params.unpack()))


bus.signal_subscribe(BUS_NAME, BUS_NAME, None, BUS_PATH, None, Gio.DBusSignalFlags.NONE, on_signal)


def pump(seconds):
    ctx = GLib.MainContext.default()
    end = time.monotonic() + seconds
    while True:
        while ctx.iteration(False):
            pass
        if time.monotonic() >= end:
            return
        time.sleep(0.05)


def notify(summary, body="", urgency=1, actions=(), hints=None):
    h = {"urgency": GLib.Variant("y", urgency)}
    for k, v in (hints or {}).items():
        h[k] = GLib.Variant("s", v)
    args = GLib.Variant("(susssasa{sv}i)", (TEST_APP, 0, "", summary, body, list(actions), h, -1))
    res = bus.call_sync(BUS_NAME, BUS_PATH, BUS_NAME, "Notify", args, GLib.VariantType("(u)"),
                        Gio.DBusCallFlags.NONE, 5000, None)
    return res.unpack()[0]


def bus_owner():
    """PID and command name of whoever holds org.freedesktop.Notifications, or None."""
    try:
        res = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                            "GetConnectionUnixProcessID", GLib.Variant("(s)", (BUS_NAME,)),
                            GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 2000, None)
    except GLib.Error:
        return None
    pid = res.unpack()[0]
    try:
        with open(f"/proc/{pid}/comm") as f:
            return pid, f.read().strip()
    except OSError:
        return pid, ""


def server_info():
    try:
        res = bus.call_sync(BUS_NAME, BUS_PATH, BUS_NAME, "GetServerInformation", None,
                            GLib.VariantType("(ssss)"), Gio.DBusCallFlags.NONE, 2000, None)
        return res.unpack()
    except GLib.Error:
        return None


# ---------------------------------------------------------------- helpers

def wait_for(pred, timeout=4.0):
    """Polls the island's state until pred(state) holds; the last state."""
    end = time.monotonic() + timeout
    s = None
    while True:
        pump(0.15)
        s = state() or {}
        try:
            if pred(s):
                return s, True
        except (KeyError, TypeError, IndexError):
            pass
        if time.monotonic() >= end:
            return s, False


def toast_title(s):
    return (s.get("toast") or {}).get("title", "")


def find_note(s, summary):
    for n in s.get("notes", []):
        if n["summary"] == summary:
            return n
    return None


def got_signal(name, nid, value, timeout=3.0):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        pump(0.1)
        if any(n == name and a[0] == nid and a[1] == value for n, a in signals):
            return True
    return False


def clear_screen():
    ipc("notifications", "dismissAll")
    wait_for(lambda s: not s["toast"] and not s["queue"], 2)


def hook(event, background=False, args=()):
    """Hands an event to the real Claude hook (args ["--codex"]: Codex's),
    outside this process tree (systemd-run), so it finds neither a claude
    process nor a window. The hook's answer comes back on the process's stdout."""
    cmd = ["systemd-run", "--user", "--quiet", "--collect", "--pipe", HOOK, *args]
    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    p.stdin.write(json.dumps(event).encode())
    p.stdin.close()
    if not background:
        p.communicate(timeout=10)
    return p


def hook_answer(p):
    """The decision a waiting hook handed to Claude, or None."""
    try:
        out, _ = p.communicate(timeout=6)
        return json.loads(out)["hookSpecificOutput"]["decision"]
    except (subprocess.TimeoutExpired, ValueError, KeyError, TypeError):
        p.kill()
        return None


def ask(sid, tool, tool_input):
    return hook({"session_id": sid, "cwd": "/tmp", "hook_event_name": "PermissionRequest", "tool_name": tool,
                 "tool_input": tool_input}, background=True)


def end_session(sid):
    subprocess.run([HOOK, "--decide", sid, "focus"], capture_output=True, timeout=5)
    hook({"session_id": sid, "cwd": "/tmp", "hook_event_name": "SessionEnd", "reason": "other"})


def layout(need=()):
    """Every clickable thing the island shows, once its size has settled and
    the named ones (or ones starting with them) are there (a click's new view
    can take a moment)."""
    last = None
    for _ in range(20):
        pump(0.25)
        try:
            now = json.loads(ipc("omarchy-buddy.test", "layout"))
        except (TypeError, ValueError):
            return {"items": [], "unreachable": ["(layout antwortet nicht)"], "flicks": []}
        if last and now["island"] == last["island"] and all(any(m.startswith(n) for m in names(now)) for n in need):
            return now
        last = now
    return last


def click(*names, wait=3.0):
    """Clicks the first of these names the island has (German, English),
    waiting for one to be there and usable (a new view can take a moment)."""
    end = time.monotonic() + wait
    while True:
        for name in names:
            if ipc("omarchy-buddy.test", "testClick", name) == "ok":
                pump(0.3)
                return True
        if time.monotonic() >= end:
            return False
        pump(0.2)


def type_text(text):
    """Types into the open text field, waiting for it to appear."""
    end = time.monotonic() + 3
    while (r := ipc("omarchy-buddy.test", "testType", text)) != "ok" and time.monotonic() < end:
        pump(0.2)
    pump(0.3)
    return r == "ok"


def names(lay):
    return [i["name"] for i in lay["items"]]


def check_reach(name, lay, need=()):
    """Every clickable inside the window or reachable by scrolling, and the
    named ones there at all."""
    missing = [n for n in need if n not in names(lay)]
    check(name, not lay["unreachable"] and not missing,
          f"unerreichbar: {lay['unreachable']}, fehlt: {missing}, Insel {lay.get('island')}, Fenster {lay.get('window')}")


def shell_log():
    """The log of the shell process that serves notifications."""
    owner = bus_owner()
    if owner:
        path = os.path.join(QS_RUN, "by-pid", str(owner[0]), "log.log")
        if os.path.exists(path):
            return path
    dirs = [os.path.join(QS_RUN, "by-id", d) for d in os.listdir(os.path.join(QS_RUN, "by-id"))]
    dirs.sort(key=os.path.getmtime)
    return os.path.join(dirs[-1], "log.log") if dirs else None


LOG_PROBLEM = re.compile(r"\s(WARN|ERROR|FATAL)\s")


def buddy_log_problems(text):
    return [l for l in text.splitlines()
            if LOG_PROBLEM.search(l) and "omarchy-buddy" in l and "qmlscanner" not in l]


# ---------------------------------------------------------------- the checks

def check_service():
    owner = bus_owner()
    info = server_info()
    check("Benachrichtigungsdienst antwortet", info is not None, "niemand hält org.freedesktop.Notifications")
    check("Dienst ist die Shell (quickshell)", bool(owner) and owner[1] in ("quickshell", "qs"),
          f"Besitzer: {owner}")
    try:
        with open(SHELL_JSON) as f:
            disabled = json.load(f).get("disabledPlugins") or []
        check("Omarchys Plugin aus (disabledPlugins)", "omarchy.notifications" in disabled,
              "omarchy.notifications fehlt in disabledPlugins")
    except (OSError, ValueError) as e:
        report("Omarchys Plugin aus (disabledPlugins)", "fehler", str(e))
    plugins = ipc("shell", "listPlugins")
    try:
        active = {p["id"]: p.get("enabled") for p in json.loads(plugins)}
        check("nur ein Dienst: Omarchys Notifications nicht geladen", active.get("omarchy.notifications") is False,
              f"omarchy.notifications enabled={active.get('omarchy.notifications')}")
    except (TypeError, ValueError, KeyError):
        report("nur ein Dienst: Omarchys Notifications nicht geladen", "übersprungen", "listPlugins antwortet nicht")
    others = [f for f in os.listdir("/usr/share/dbus-1/services") if "Notifications" in f] \
        if os.path.isdir("/usr/share/dbus-1/services") else []
    check("kein zweiter Dienst per D-Bus-Aktivierung", not others, ", ".join(others))


def check_popups(run):
    clear_screen()
    t = f"Normal {run}"
    notify(t, "normale Meldung")
    s, ok = wait_for(lambda s: toast_title(s) == t)
    check("normal: Pop-up", ok, f"Pop-up: {toast_title(s)!r}")
    check("normal: im Verlauf", find_note(s, t) is not None)
    r = ipc("notifications", "dismissOne")
    s, ok = wait_for(lambda s: toast_title(s) != t, 2)
    check("IPC dismissOne", r == "ok" and ok, f"Antwort {r!r}, Pop-up {toast_title(s)!r}")

    for kind, category in (("chat", "im.received"), ("mail", "email.arrived")):
        t = f"Nachricht {kind} {run}"
        notify(t, "von einem Menschen", hints={"category": category})
        s, ok = wait_for(lambda s: toast_title(s) == t)
        n = find_note(s, t) or {}
        check(f"Nachricht von Menschen: {kind}-Zeichen im Pop-up und Verlauf (#123)",
              ok and s["toast"].get("kind") == kind and n.get("kind") == kind, f"Pop-up: {s.get('toast')}, Eintrag: {n}")
        ipc("notifications", "dismissOne")
        wait_for(lambda s: toast_title(s) != t, 2)

    t = f"Niedrig {run}"
    notify(t, "nur Verlauf", urgency=0)
    s, ok = wait_for(lambda s: find_note(s, t) is not None)
    pump(0.8)
    s = state() or {}
    check("niedrig: nur im Verlauf", ok and toast_title(s) != t, f"Pop-up: {toast_title(s)!r}")

    t = f"Kritisch {run}"
    notify(t, "bleibt stehen", urgency=2)
    s, ok = wait_for(lambda s: toast_title(s) == t and s["toast"]["sticky"])
    check("kritisch: Pop-up bleibt stehen", ok, f"Pop-up: {s.get('toast')}")
    r = ipc("notifications", "dismissAll")
    s, ok = wait_for(lambda s: not s["toast"], 2)
    check("IPC dismissAll", r == "ok" and ok, f"Antwort {r!r}")

    t = f"Bündel {run}"
    for i in range(3):
        notify(t, f"Nachricht {i + 1}")
    s, ok = wait_for(lambda s: toast_title(s) == t and s["toast"]["count"] == 3 and s["toast"]["body"] == "Nachricht 3")
    check("Bündeln: drei vom selben Absender in einem Pop-up", ok, f"Pop-up: {s.get('toast')}")
    clear_screen()

    for i in range(6):
        notify(f"Flut {run} {i + 1}", "")
    s, ok = wait_for(lambda s: any(re.match(r"\d+ (Meldungen|notifications)$", q["title"]) for q in s["queue"]))
    check("Flut: Sammelmeldung statt langer Schlange", ok, f"Schlange: {[q['title'] for q in s.get('queue', [])]}")
    clear_screen()


def check_actions(run):
    t = f"Aktion {run}"
    nid = notify(t, "mit Knopf", actions=["open", "Öffnen"])
    s, _ = wait_for(lambda s: find_note(s, t) is not None)
    n = find_note(s, t) or {}
    check("Aktion: Knopf kommt an", n.get("actions") == ["open"] and n.get("live"), f"Eintrag: {n}")
    r = ipc("omarchy-buddy.test", "testAction", n.get("key", ""), "open")
    check("Aktion: App erfährt den Klick (ActionInvoked)", r == "ok" and got_signal("ActionInvoked", nid, "open"),
          f"Antwort {r!r}")

    t = f"Antwort {run}"
    nid = notify(t, "mit Antwortfeld", actions=["inline-reply", "Antworten"],
                 hints={"x-kde-reply-placeholder-text": "Antwort an Test"})
    s, _ = wait_for(lambda s: (find_note(s, t) or {}).get("reply"))
    n = find_note(s, t) or {}
    check("Antwort: Feld wird angeboten", n.get("reply") is True, f"Eintrag: {n}")
    r = ipc("omarchy-buddy.test", "testReply", n.get("key", ""), "Hallo von O-Morchy")
    check("Antwort: App bekommt den Text (NotificationReplied)",
          r == "ok" and got_signal("NotificationReplied", nid, "Hallo von O-Morchy"), f"Antwort {r!r}")

    clear_screen()
    t = f"Standard {run}"
    nid = notify(t, "Klick öffnet", actions=["default", "Öffnen"])
    wait_for(lambda s: toast_title(s) == t)
    r = ipc("notifications", "invokeLast")
    check("IPC invokeLast löst die Standardaktion aus", r == "ok" and got_signal("ActionInvoked", nid, "default"),
          f"Antwort {r!r}")

    t = f"Erstlauf-Hinweis {run}"
    notify(t, "", urgency=2)
    wait_for(lambda s: toast_title(s) == t)
    r = ipc("notifications", "dismiss", "Erstlauf-Hinweis")
    s, ok = wait_for(lambda s: toast_title(s) != t, 2)
    check("IPC dismiss nach Titel (omarchy-notification-dismiss)", r == "ok" and ok, f"Antwort {r!r}")
    clear_screen()


def check_omarchy_45(run):
    """Omarchy 4.5: buttons from the omarchy-actions hint, act, invokeAction,
    keyboard and count (Super + Komma and friends)."""
    clear_screen()
    marks = [os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), f"omarchy-buddy-test-{run}-{i}") for i in (1, 2)]
    commands = [{"label": f"Eins {run}", "argv": ["touch", marks[0]]}, {"label": f"Zwei {run}", "argv": ["touch", marks[1]]}]
    t = f"Omarchy-Knöpfe {run}"
    notify(t, "", hints={"omarchy-actions": json.dumps(commands), "omarchy-exec-argv": json.dumps(commands[0]["argv"])})
    s, ok = wait_for(lambda s: toast_title(s) == t)
    n = find_note(s, t) or {}
    check("4.5: Knöpfe aus omarchy-actions im Datensatz", n.get("commands") == [c["label"] for c in commands], f"Eintrag: {n}")
    if ok:
        check_reach("4.5: Knöpfe aus omarchy-actions im Pop-up", layout([commands[1]["label"]]), [c["label"] for c in commands])
    r = ipc("notifications", "invokeAction", 2)
    wait_for(lambda s: os.path.exists(marks[1]), 3)
    check("4.5: IPC invokeAction 2 startet den zweiten Befehl", r == "ok" and os.path.exists(marks[1])
          and not os.path.exists(marks[0]), f"Antwort {r!r}")
    for m in marks:
        if os.path.exists(m):
            os.remove(m)

    t = f"Act ohne Knopf {run}"
    notify(t, "")
    wait_for(lambda s: toast_title(s) == t)
    r = ipc("notifications", "act")
    s, ok = wait_for(lambda s: toast_title(s) != t, 2)
    check("4.5: IPC act ohne Knopf legt weg", r == "ok" and ok, f"Antwort {r!r}")
    t = f"Act ein Knopf {run}"
    nid = notify(t, "", actions=["ok", "OK"])
    wait_for(lambda s: toast_title(s) == t)
    r = ipc("notifications", "act")
    check("4.5: IPC act drückt den einen Knopf", r == "ok" and got_signal("ActionInvoked", nid, "ok"), f"Antwort {r!r}")
    t = f"Act Klick {run}"
    nid = notify(t, "", actions=["default", "Öffnen"])
    wait_for(lambda s: toast_title(s) == t)
    check("4.5: IPC count", ipc("notifications", "count") == "1")
    r = ipc("notifications", "act")
    check("4.5: IPC act klickt", r == "ok" and got_signal("ActionInvoked", nid, "default"), f"Antwort {r!r}")

    t = f"Act zwei Knöpfe {run}"
    notify(t, "", actions=["a", f"Erster {run}", "b", "Zweiter"])
    wait_for(lambda s: toast_title(s) == t)
    r = ipc("notifications", "act")
    try:
        s, ok = wait_for(lambda s: s["opened"], 2)
        end = time.monotonic() + 2
        while ipc("omarchy-buddy.test", "focused") != f"Erster {run}" and time.monotonic() < end:
            pump(0.1)
        focus = ipc("omarchy-buddy.test", "focused")
        check("4.5: IPC act mit zwei Knöpfen = keyboard: große Ansicht, erster Knopf hat den Fokus",
              r == "on" and ok and focus == f"Erster {run}", f"Antwort {r!r}, Fokus {focus!r}")
        r = ipc("notifications", "keyboard")
        s, ok = wait_for(lambda s: not s["opened"], 2)
        check("4.5: IPC keyboard ein zweites Mal schließt", r == "off" and ok, f"Antwort {r!r}")
    finally:
        ipc("omarchy-buddy", "close")
        wait_for(lambda s: not s["opened"], 2)
    clear_screen()


EMOTES = ("ask", "outage", "alarm", "done", "failed", "relief", "mail", "chat")


def check_emotes():
    """O-Morchy's #177 emotions play in the bar widget; QML errors would show in check_log."""
    bad = []
    for e in EMOTES:
        if ipc("omarchy-buddy.test", "testEmote", e) is None:
            bad.append(e)
        pump(0.4)
    ipc("omarchy-buddy.test", "testEmote", "")
    check("O-Morchy spielt die Emotionen (#177)", not bad, f"keine Antwort bei {bad}")


def check_feelings(run):
    """#177: an event's emotion plays as its pop-up appears; a stronger one
    playing is not replaced; a letter leaves with its pop-up."""
    clear_screen()
    keys = [f"buddy-test-{run}-e{i}" for i in range(3)]
    try:
        say = lambda key, source, level, title: subprocess.run(  # noqa: E731
            [SAY, "--source", source, "--level", level, "--key", key, title, ""], timeout=5)
        say(keys[0], "terminal", "good", f"Befehl fertig {run}")
        s, ok = wait_for(lambda s: toast_title(s) == f"Befehl fertig {run}" and s["emote"] == "done")
        check("Emotion: langer Befehl fertig nickt (#177)", ok, f"Pop-up {toast_title(s)!r}, Emotion {s.get('emote')!r}")
        clear_screen()
        say(keys[1], "kuma", "warn", f"Dienst aus {run}")
        say(keys[2], "terminal", "error", f"Befehl fehlgeschlagen {run}")
        s, ok = wait_for(lambda s: toast_title(s) == f"Dienst aus {run}" and s["emote"] == "outage")
        check("Emotion: Kuma-Ausfall (#177)", ok, f"Pop-up {toast_title(s)!r}, Emotion {s.get('emote')!r}")
        ipc("notifications", "dismissOne")
        s, ok = wait_for(lambda s: toast_title(s) == f"Befehl fehlgeschlagen {run}", 2)
        check("Emotion: der Ausfall gewinnt gegen „fehlgeschlagen“ (#177)", ok and s["emote"] == "outage",
              f"Pop-up {toast_title(s)!r}, Emotion {s.get('emote')!r}")
        clear_screen()
        wait_for(lambda s: s["emote"] == "", 4)  # the outage still plays and would win
        notify(f"Rechnung {run}", "", hints={"category": "email.arrived"})
        s, ok = wait_for(lambda s: toast_title(s) == f"Rechnung {run}" and s["emote"] == "mail")
