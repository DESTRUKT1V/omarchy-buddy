        check("Verlauf: alle löschen leert ihn (Leerzustand)", ok and "alle löschen" not in names(lay), f"{s.get('noteCount')} übrig")
        check_reach("Leerzustand: Rückgängig erreichbar", lay, ["Rückgängig"])
