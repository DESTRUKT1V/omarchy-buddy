def check_question(run, en=False):
    """AskUserQuestion, 4 questions × 4 long options, one with several
    choices, one with an own answer: all reachable, the answers reach Claude."""
    tag = " (Englisch, Zoom 1,6)" if en else ""
    sid = f"buddy-test-{run}-q{'en' if en else ''}"
    questions = long_questions(run)
    waiting = ask(sid, "AskUserQuestion", {"questions": questions})
    try:
        s, ok = wait_for(lambda s: s["ask"]["session"] == sid and s["ask"]["kind"] == "question", 6)
        if not check("lange Frage: kommt als Frage mit 4 Teilen" + tag, ok and s["ask"]["questions"] == 4, f"Rückfrage {s.get('ask')}"):
            return
        answer = "Answer" if en else "Antworten"
        lay = layout()
        check_reach("lange Frage: alle Möglichkeiten und Knöpfe erreichbar" + tag, lay,
                    [answer] + [o["label"] for q in questions for o in q["options"]])
        check("lange Frage: Inhalt scrollt" + tag, any(f["interactive"] for f in lay["flicks"]), f"Flächen {lay['flicks']}")
        btn = next((i for i in lay["items"] if i["name"] == answer), {})
        check(f"lange Frage: „{answer}“ wartet auf alle Antworten" + tag, btn.get("enabled") is False, f"Knopf {btn}")
        if en:
            return
        # "Eigene Antwort" is a row like the options, once per question; the first is question 1's.
        own = next((i for i in lay["items"] if i["name"] == "Eigene Antwort"), {})
        first = next((i for i in lay["items"] if i["name"] == questions[0]["options"][0]["label"]), {})
        check("Eigene Antwort: Auswahlzeile wie die Möglichkeiten", own.get("reach") and own.get("x") == first.get("x")
              and own.get("w") == first.get("w"), f"Eigene {own}, Möglichkeit {first}")
        click("Eigene Antwort", "Own answer")
        need = ["Schicken", "Abbrechen"]
        check_reach("Eigene Antwort: Feld mit Schicken/Abbrechen erreichbar", layout(need), need)
        type_text(f"Eigene Antwort {run}")
        click(questions[1]["options"][0]["label"])
        click(questions[1]["options"][3]["label"])
        click(questions[2]["options"][2]["label"])
        click(questions[3]["options"][1]["label"])
        lay = layout()
        btn = next((i for i in lay["items"] if i["name"] == answer), {})
        check("lange Frage: „Antworten“ geht, wenn alles beantwortet ist", btn.get("enabled") is True and btn.get("reach"),
              f"Knopf {btn}")
        click(answer)
        result = hook_answer(waiting)
        want = {questions[0]["question"]: f"Eigene Antwort {run}",
                questions[1]["question"]: questions[1]["options"][0]["label"] + ", " + questions[1]["options"][3]["label"],
                questions[2]["question"]: questions[2]["options"][2]["label"],
                questions[3]["question"]: questions[3]["options"][1]["label"]}
        got = ((result or {}).get("updatedInput") or {}).get("answers")
        check("lange Frage: Claude bekommt alle Antworten (Mehrfachauswahl, eigene)", got == want, f"bekommen {got}")
    finally:
        end_session(sid)
        if waiting.poll() is None:
            waiting.kill()


