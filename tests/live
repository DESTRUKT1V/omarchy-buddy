def other_playing():
    """Does a player other than tests/fake-player play right now?"""
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    names = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "ListNames",
                          None, None, Gio.DBusCallFlags.NONE, 2000).unpack()[0]
    for name in names:
        if not name.startswith("org.mpris.MediaPlayer2.") or name.endswith(".buddytest"):
            continue
        try:
            status = bus.call_sync(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "Get",
                                   GLib.Variant("(ss)", ("org.mpris.MediaPlayer2.Player", "PlaybackStatus")),
                                   None, Gio.DBusCallFlags.NONE, 2000).unpack()[0]
        except GLib.Error:
            continue
        if status == "Playing":
            return True
    return False


def check_player():
    """The player window beside the open view with tests/fake-player (the
    test IPC never clicks the user's own music): it shows while a track is
    loaded, also paused; greyed-out buttons do nothing; it goes with the view."""
    fake = subprocess.Popen([os.path.join(os.path.dirname(os.path.abspath(__file__)), "fake-player"), "--no-prev"],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    try:
        ipc("omarchy-buddy", "open")
        mine = lambda s: (s.get("player") or {}).get("identity") == "Buddy-Test"  # noqa: E731
        s, ok = wait_for(lambda s: mine(s) and s["player"]["shown"] and s["player"]["playing"], 5)
        check("Player: Fenster neben der großen Ansicht", ok, f"player {s.get('player')}")
        check("Player: Pause", click("Pausieren", "Pause"))
        if other_playing():
            report("Player: pausiert bleibt das Fenster", "übersprungen", "ein anderer Player spielt, der gewinnt")
        else:
            s, ok = wait_for(lambda s: mine(s) and not s["player"]["playing"] and s["player"]["shown"])
            check("Player: pausiert bleibt das Fenster", ok, f"player {s.get('player')}")
        check("Player: was der Player nicht kann, ist ausgegraut", not click("Vorheriger Titel", "Previous track"))
        ipc("omarchy-buddy", "close")
        s, ok = wait_for(lambda s: not s["opened"] and not (s.get("player") or {}).get("shown"))
        check("Player: schließt mit der großen Ansicht", ok, f"player {s.get('player')}")
    finally:
        ipc("omarchy-buddy", "close")
        fake.terminate()
        calls = fake.communicate(timeout=5)[0].split()
    check("Player: der Klick erreicht den Player", calls in (["PlayPause"], ["Pause"]), f"Aufrufe {calls}")
    s, ok = wait_for(lambda s: (s.get("player") or {}).get("identity") != "Buddy-Test")
    check("Player: weg, wenn der Player geht", ok)


def check_spotify_key():
    """Spotify's + without a connection (#162): tests/fake-player named
    like Spotify's desktop app, tests/fake-hyprctl instead of hyprctl (set
    before the player starts), so the shortcut never reaches the user's
    Spotify. Shown, a click sends it to the window's address, a short
    feedback, a failed send hides the +."""
    here = os.path.dirname(os.path.abspath(__file__))
    hyprctl = os.path.join(here, "fake-hyprctl")
    fd, log = tempfile.mkstemp(prefix="buddy-test-hyprctl-")
    os.close(fd)
    names = ("In deinen Lieblingssongs speichern oder entfernen", "Save to or remove from your Liked Songs")
    ipc("omarchy-buddy.test", "testSpotify", json.dumps({"connected": False, "hyprctl": [hyprctl, log]}))
    fake = subprocess.Popen([os.path.join(here, "fake-player"), "--spotify-app"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        ipc("omarchy-buddy", "open")
        mine = lambda s: (s.get("player") or {}).get("identity") == "Buddy-Test"  # noqa: E731
        s, ok = wait_for(lambda s: mine(s) and s["spotify"]["like"] == "toggle", 5)
        check("Spotify ohne Verbindung: + bei Spotifys App", ok, f"spotify {s.get('spotify')}")
        check("Spotify ohne Verbindung: Klick aufs Herz", click(*names))
        s, ok = wait_for(lambda s: s["spotify"]["like"] == "sent")
        check("Spotify ohne Verbindung: kurze Rückmeldung", ok, f"spotify {s.get('spotify')}")
        with open(log) as f:
            sent = f.read().splitlines()
        check("Spotify ohne Verbindung: Kürzel an die Adresse des Fensters",
              sent == ['hl.dsp.send_shortcut({ mods = "ALT SHIFT", key = "B", window = "address:0x162" })'], f"{sent}")
        ipc("omarchy-buddy.test", "testSpotify", json.dumps({"connected": False, "hyprctl": [hyprctl, log, "--fail"]}))
        wait_for(lambda s: s["spotify"]["like"] == "toggle")
        click(*names)
        s, ok = wait_for(lambda s: s["spotify"]["like"] == "")
        check("Spotify ohne Verbindung: Fehler blendet das Herz aus", ok, f"spotify {s.get('spotify')}")
    finally:
        ipc("omarchy-buddy.test", "testSpotify", "")
        ipc("omarchy-buddy", "close")
        fake.terminate()
        fake.wait(timeout=5)
        os.unlink(log)


def check_sharing(run, wanted):
    name = "Ruhemodus beim Bildschirmteilen"
    if not wanted:
        report(name, "übersprungen", "nur mit --teilen")
        return
    s = state() or {}
    if s.get("quiet"):
        report(name, "übersprungen", "Ruhemodus ist ohnehin an")
        return
    print("  Starte jetzt eine Bildschirmfreigabe (z. B. im Browser), ich warte bis zu 2 Minuten …", flush=True)
    s, ok = wait_for(lambda s: s["sharing"], 120)
    if not check(name + ": Insel merkt die Freigabe", ok, "kein screencast-Ereignis von Hyprland"):
        return
    clear_screen()
    t = f"Beim Teilen {run}"
    notify(t, "sollte still in den Verlauf")
    s, _ = wait_for(lambda s: find_note(s, t) is not None)
    pump(0.8)
    s = state() or {}
    check(name + ": normale Meldung still", find_note(s, t) is not None and toast_title(s) != t,
          f"Pop-up {toast_title(s)!r}")
    t = f"Kritisch beim Teilen {run}"
    notify(t, "kommt trotzdem", urgency=2)
    s, ok = wait_for(lambda s: toast_title(s) == t)
    check(name + ": kritische Meldung kommt", ok, f"Pop-up {toast_title(s)!r}")
    clear_screen()
    print("  Du kannst die Freigabe jetzt beenden.", flush=True)
    s, ok = wait_for(lambda s: not s["sharing"], 60)
    check(name + ": Ende der Freigabe erkannt", ok)


def check_settings():
