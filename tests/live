    """A question from a session whose terminal has the focus right now (the
    one running this test): the island still shows it and can answer it."""
    sid = f"buddy-test-{run}-blick"
    window = json.loads(subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True).stdout or "{}").get("address")
    if not window:
        report("Rückfrage im Blick", "übersprungen", "kein fokussiertes Fenster")
        return
    hook({"session_id": sid, "cwd": "/tmp", "hook_event_name": "SessionStart"})
    # The hook under systemd-run finds no window; give the session this one.
    run_dir = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "omarchy-buddy")
    with open(os.path.join(run_dir, "lock"), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(os.path.join(run_dir, "state.json")) as f:
            data = json.load(f)
        data[sid]["window"] = window
        with open(os.path.join(run_dir, "state.json.tmp"), "w") as f:
            json.dump(data, f)
        os.replace(os.path.join(run_dir, "state.json.tmp"), os.path.join(run_dir, "state.json"))
    question = {"question": f"Im Blick {run}: weiter?", "header": "Blick", "multiSelect": False,
