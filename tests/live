        check("Verlauf: lange Meldung gekürzt", bool(before) and before["truncated"], f"Eintrag {before}")
        click(f"Anfang {run}")
        lay = layout([f"Anfang {run}"])
        after = next((i for i in lay["items"] if i["name"].startswith(f"Anfang {run}")), None)
