def check_screenshot():
    # A screenshot sends Hyprland's screencast event for a moment; the island
    # must not take it for sharing (it would go quiet and veiled).
    name = "Bildschirmfoto gilt nicht als Teilen"
    if not shutil.which("grim"):
        report(name, "übersprungen", "grim fehlt")
        return
    subprocess.run(["grim", "-g", "0,0 8x8", "-"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    s, shared = wait_for(lambda s: s["sharing"], 2.0)
    check(name, not shared)


def saved():
    """What the island and omarchy-buddy-say keep on disk, file → list."""
    out = {}
    for name in SAVED:
        try:
            with open(os.path.join(STATE_DIR, name)) as f:
                items = json.load(f)
        except (OSError, ValueError):
            items = []
        out[name] = items if isinstance(items, list) else []
    return out


def check_saved(before):
    """After the run (#126): no test record on disk, no real one pushed out
    (unless as many real ones came in meanwhile)."""
    pump(1.5)  # the island writes 1 s after the last change
    after = saved()
    test = lambda i: isinstance(i, dict) and (i.get("app") == TEST_APP or str(i.get("key", "")).startswith("buddy-test-"))  # noqa: E731
    ident = lambda i: json.dumps(i.get("key") or i.get("time"))  # noqa: E731
    for name in SAVED:
        left = [i for i in after[name] if test(i)]
        # Finished runs from before #173 leave news.json on its next write.
        old = {ident(i) for i in before[name] if isinstance(i, dict) and not buddy.popup_only(i)}
        now = {ident(i) for i in after[name] if isinstance(i, dict)}
        gone, came = old - now, now - old
        check(f"{name}: keine Testeinträge gespeichert", not left, f"{len(left)} übrig")
        check(f"{name}: kein echter Eintrag fehlt", len(gone) <= len(came), f"{len(gone)} fehlen")


def check_log(log, start_size):
    if not log:
        report("kein QML-Fehler im Log", "übersprungen", "kein Log gefunden")
        return
    with open(log, errors="replace") as f:
        text = f.read()
    problems = buddy_log_problems(text)
    new = buddy_log_problems(text[start_size:])
    check("kein QML-Fehler im Log (seit Shell-Start)", not problems, "\n    " + "\n    ".join(problems[-5:]))
    if problems:
        check("kein neuer QML-Fehler während des Tests", not new, f"{len(new)} neue")


def wait_until_ready(patient):
    """The user is at the PC, nothing fullscreen, the island at rest. Patient:
    wait up to two hours for that (after an update the user may be away)."""
    limit = 7200 if patient else 15
    end = time.monotonic() + limit
    while True:
        s = state() or {}
        calm = not s.get("paused") and not s.get("sharing") and not s.get("opened") and not s.get("ask") \
            and s.get("mode") in ("pill", "peek")
        if calm or time.monotonic() >= end:
            return s
        time.sleep(5 if patient else 1)


def main():
    p = argparse.ArgumentParser(description="Live-Test der Insel in der laufenden Shell.")
    p.add_argument("--teilen", action="store_true", help="auch den Ruhemodus beim Bildschirmteilen prüfen")
    p.add_argument("--warten", action="store_true", help="erst warten, bis du da bist und die Insel ruhig ist")
    args = p.parse_args()

    if ipc("omarchy-buddy.test", "ping") != "ok":
        report("Insel geladen (Test-IPC antwortet)", "fehler", "omarchy-buddy.test antwortet nicht")
        check_service()
        return 2
    report("Insel geladen (Test-IPC antwortet)", "ok")
    log = shell_log()
    start_size = os.path.getsize(log) if log else 0
    run = time.strftime("%H%M%S")

    s = wait_until_ready(args.warten)
    # Away, fullscreen, a shared screen, a real Claude request or the open view hold pop-ups back by design.
    held = "du warst weg oder Vollbild" if s.get("paused") else \
        "der Bildschirm wird gerade geteilt" if s.get("sharing") else \
        "eine Claude-Rückfrage ist offen" if s.get("ask") else \
        "die große Ansicht ist offen" if s.get("opened") else ""
    if held:
        report("Pop-ups", "übersprungen", held)
    quiet = s.get("quiet")
    if quiet:
        ipc("notifications", "setDnd", "off")
    before = saved()
    try:
        check_service()
        if not held:
            check_popups(run)
            check_actions(run)
            check_claude(run)
            check_long_asks(run)
            check_in_view(run)
            check_done_popup(run)
            check_for_you(run)
            check_feelings(run)
            check_many_actions(run)
            check_omarchy_45(run)
            check_history(run, clear_all=not args.warten)
        check_omarchy_ipc()
        check_emotes()
        check_settings()
        if not held:
            check_settings_page()
            check_player()
            check_spotify_key()
            check_screenshot()
            check_sharing(run, args.teilen)
    finally:
        ipc("omarchy-buddy.test", "testForget")
        ipc("omarchy-buddy.test", "testSettings", "")
        if quiet:
            ipc("notifications", "setDnd", "on")
    check_saved(before)
    check_log(log, start_size)

    failed = [r for r in results if r[1] == "fehler"]
    skipped = [r for r in results if r[1] == "übersprungen"]
    print(f"\n{len(results) - len(failed) - len(skipped)} ok, {len(failed)} Fehler, {len(skipped)} übersprungen")
    if not failed:
        return 0
    return 3 if all("(dabei: " in r[2] for r in failed) else 1  # "(dabei: …)" comes from disturbed()


if __name__ == "__main__":
    sys.exit(main())
