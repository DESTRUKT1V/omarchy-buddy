def ys(lay, name):
    return [i["y"] for i in lay["items"] if i["name"] == name]


def check_for_you(run):
    """"Für dich" (#175): a mail stands above the agents, once; a plain
    message stays below them. #178: it stays after its pop-up and the view
    closing, until its × deletes it."""
    clear_screen()
    sids = [f"buddy-test-{run}-fd{i}" for i in range(3)]
    for i, sid in enumerate(sids):
        hook({"session_id": sid, "cwd": f"/tmp/fuer-dich-{i}", "hook_event_name": "UserPromptSubmit", "prompt": "Galerie"})
    mail, plain = f"Rechnung {run}", f"Paket {run}"
    notify(mail, "Deine Rechnung ist da.", urgency=0, hints={"category": "email.arrived"})
    notify(plain, "Zustellung heute", urgency=0)
    wait_for(lambda s: find_note(s, mail) and find_note(s, plain))
    ipc("omarchy-buddy", "open")
    try:
        wait_for(lambda s: s["opened"], 2)
        lay = layout([mail, plain])
        hides = ys(lay, "Ausblenden") or ys(lay, "Hide")
        check("Für dich: Mail einmal, über den Agents (#175)",
              len(ys(lay, mail)) == 1 and bool(hides) and ys(lay, mail)[0] < min(hides), f"Mail {ys(lay, mail)}, Agents {hides}")
        check("Für dich: andere Meldung unter den Agents (#175)",
              len(ys(lay, plain)) == 1 and bool(hides) and ys(lay, plain)[0] > max(hides), f"Meldung {ys(lay, plain)}, Agents {hides}")
        check_reach("Für dich: alles erreichbar", lay)
    finally:
        ipc("omarchy-buddy", "close")
        wait_for(lambda s: not s["opened"], 2)
    # #178: a mail and a critical one seen as pop-ups, the view opened and
    # closed: still in the block, until their × deletes them.
    pop, crit = f"Rechnung als Pop-up {run}", f"Akku fast leer {run}"
    notify(pop, "Deine Rechnung ist da.", hints={"category": "email.arrived"})
    wait_for(lambda s: toast_title(s) == pop)
    notify(crit, "Noch 5 %", urgency=2)
    wait_for(lambda s: find_note(s, crit))
    clear_screen()
    try:
        for turn in ("nach dem Pop-up", "nach Schließen und Öffnen"):
            ipc("omarchy-buddy", "open")
            wait_for(lambda s: s["opened"], 2)
            lay = layout([pop, crit])
            hides = ys(lay, "Ausblenden") or ys(lay, "Hide")
            check(f"Für dich bleibt {turn} (#178)",
                  bool(hides) and all(len(ys(lay, n)) == 1 and ys(lay, n)[0] < min(hides) for n in (pop, crit)),
                  f"Mail {ys(lay, pop)}, Kritisch {ys(lay, crit)}, Agents {hides}")
            ipc("omarchy-buddy", "close")
            wait_for(lambda s: not s["opened"], 2)
        ipc("omarchy-buddy", "open")
        wait_for(lambda s: s["opened"], 2)
        click(f"Aus dem Verlauf löschen: {pop}", f"Remove from history: {pop}")
        s, ok = wait_for(lambda s: not find_note(s, pop))
        check("Für dich: × löscht es aus dem Verlauf (#178)", ok and not ys(layout(), pop), "Mail noch da")
    finally:
        ipc("omarchy-buddy", "close")
        wait_for(lambda s: not s["opened"], 2)
        for sid in sids:
            end_session(sid)
        clear_screen()


