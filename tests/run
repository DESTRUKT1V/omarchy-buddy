#!/usr/bin/env bash
# All tests, without the shell: the island's rules (tests/*.test.js, Node),
# the recorded Claude Code hook inputs and the hook's decisions
# (tests/hook-test.py), the setup in a sandbox HOME (tests/setup-test.py),
# the feed with fixed inputs (tests/feed-test.py), the Spotify helper against
# a stand-in server (tests/spotify-test.py), the update check's
# Rückfall (tests/check-test.sh), install.sh and the stable clone
# (tests/install-test.sh) and, byte for byte, what the hook and the
# setup write (tests/golden-test.py). Takes a few seconds.
set -uo pipefail
cd "$(dirname "$0")/.."
status=0
node --test tests/*.test.js || status=1
for t in tests/hook-test.py tests/setup-test.py tests/feed-test.py tests/spotify-test.py tests/check-test.sh tests/install-test.sh tests/golden-test.py; do
  "$t" || status=1
done
exit $status
